import { StyleMetrics, HorizontalBox } from "std-widgets.slint";
import { TextBox, LineInput } from "text_box.slint";

component SubjectVerbObject {
    in-out property <string> subject-text <=> subject.text;
    in-out property <string> verb-text <=> verb.text;
    in-out property <string> object-text <=> object.text;

    in property <bool> subject_focused;
    changed subject_focused => {
        if subject_focused {
            subject.focus();
        } else if subject.has-focus {
            //subject.clear-focus()
        }
    }

    in property <bool> verb_focused;
    changed verb_focused => {
        if verb_focused {
            verb.focus()
        } else if verb.has_focus {
            //verb.clear-focus()
        }
    }

    in property <bool> object_focused;
    changed object_focused => {
        if object_focused {
            object.focus();
        } else if object.has-focus {
            //object.clear-focus()
        }
    }

    callback subject_accepted();
    callback verb_accepted();
    callback object_accepted();

    in property <bool> subject-visible: true;
    in property <bool> verb-visible: true;
    in property <bool> object-visible: true;

    in property <bool> subject-enabled: true;
    in property <bool> verb-enabled: true;
    in property <bool> object-enabled: true;

    in property <bool> subject-read-only: false;
    in property <bool> verb-read-only: false;
    in property <bool> object-read-only: false;

    in property <brush> subject-background;
    in property <brush> verb-background;
    in property <brush> object-background;

    in property <length> border-width;
    in property <length> border-radius;

    in property <brush> subject-border-color: subject-background.darker(50%);
    in property <brush> verb-border-color: verb-background.darker(50%);
    in property <brush> object-border-color: object-background.darker(50%);

    in property <length> font-size;
    in property <int> font-weight;
    in property <color> text-color;

    in property <length> box-width;
    in property <length> spacing <=> layout.spacing;

    in property <TextHorizontalAlignment> horizontal_alignment;
    in property <TextVerticalAlignment> vertical_alignment;

    layout := HorizontalLayout {
        spacing: 50px;

        subject := LineInput {
            visible: subject-visible;

            text-color: root.text-color;
            font-size: root.font-size;
            font-weight: root.font-weight;

            enabled: subject-enabled;
            read_only: subject-read-only;

            width: box-width;

            background: subject-background;

            border-width: root.border-width;
            border-radius: root.border-radius;
            border-color: subject-border-color;

            horizontal_alignment: root.horizontal_alignment;
            vertical_alignment: root.vertical_alignment;

            accepted => {
                subject_accepted()
            }
        }

        verb := LineInput {
            visible: verb-visible;

            text-color: root.text-color;
            font-size: root.font-size;
            font-weight: root.font-weight;

            enabled: verb-enabled;
            read_only: verb-read-only;

            width: box-width;

            background: verb-background;

            border-width: root.border-width;
            border-radius: root.border-radius;
            border-color: verb-border-color;

            horizontal_alignment: root.horizontal_alignment;
            vertical_alignment: root.vertical_alignment;

            accepted => {
                verb_accepted()
            }
        }

        object := LineInput {
            visible: object-visible;

            text-color: root.text-color;
            font-size: root.font-size;
            font-weight: root.font-weight;

            enabled: object-enabled;
            read_only: object-read-only;

            width: box-width;

            background: object-background;

            border-width: root.border-width;
            border-radius: root.border-radius;
            border-color: object-border-color;

            horizontal_alignment: root.horizontal_alignment;
            vertical_alignment: root.vertical_alignment;

            accepted => {
                object_accepted()
            }
        }
    }
}

export component BasicPhraseStage inherits Rectangle {
    property <int> stage: 0;

    out property <string> subject: "";
    out property <string> verb: "";
    out property <string> object: "";

    public function next() {
        stage += 1;
    }
    public function back() {
        stage -= 1;

        if stage == -1 {
            exit();
        }
    }

    changed visible => {
        self.reset();
    }

    public function reset() {
        stage = 0;
        subject = "";
        verb = "";
        object = "";
    }

    private property <int> line_n: stage / 2;
    private property <int> column_n: Math.mod((stage), 2);

    private property <[{ subject: string, object: string}]> lines: [{ subject: "", object: "" }, { subject: "", object: "" }, { subject: "", object: "" }];

    main := VerticalLayout {
        padding: 15px;
        spacing: 10px;

        Rectangle {
            vertical-stretch: 1;
        }

        head := SubjectVerbObject {
            subject-text: "Vem";
            object-text: "Vad";

            text-color: black;
            font-size: 24px;
            font-weight: 600;

            height: 75px;
            box-width: 250px;

            spacing: 50px;

            border-radius: 5px;
            border-width: 2px;

            subject-background: lightblue;
            verb-background: orangered;
            object-background: lightgreen;

            verb-visible: stage > 0;

            subject-read-only: true;

            verb-read-only: stage != 1;
            verb_focused: !self.verb-read-only;

            subject_focused: stage == 0;

            object-read-only: true;

            horizontal_alignment: center;
            vertical_alignment: center;
        }

        Rectangle {
            height: 10px;
        }

        for line[index] in lines: SubjectVerbObject {
            subject-text: line.subject;
            verb-text: head.verb-text;
            object-text: line.object;

            text-color: black;
            font-size: 24px;
            font-weight: 600;

            height: 75px;
            box-width: 250px;

            spacing: 50px;

            border-radius: 5px;
            border-width: 2px;

            verb-background: orangered;

            subject-border-color: lightblue;
            object-border-color: lightgreen;

            subject-visible: line_n > index;
            verb-visible: false;
            object-visible: line_n > index;

            subject-read-only: line_n > index + 1 || column_n == 1;
            verb-read-only: true;
            object-read-only: line_n > index + 1 || column_n == 0;

            subject_focused: self.subject_visible && !self.subject-read-only;
            object_focused: self.object_visible && !self.object-read-only;

            horizontal_alignment: center;
            vertical_alignment: center;
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }

    callback done();
    callback exit();
}

    export component ExpandPhraseStage inherits Rectangle {
    in property <string> subject: "";
    in property <string> verb: "";
    in property <string> object: "";

    callback done();
}
