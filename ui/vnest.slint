import { StyleMetrics, HorizontalBox } from "std-widgets.slint";
import { TextBox, LineInput } from "text_box.slint";
import { SubjectVerbObject } from "svo.slint";

global Style {
    out property <brush> subject-color:  #DDEAF6;
    out property <brush> verb-color:  #F4AF91;
    out property <brush> object-color:  #E1EFD8;

    out property <brush> subject-border: #BACDDD;
    out property <brush> verb-border: #A56C46;
    out property <brush> object-border: #BBC8B2;

    out property <brush> where-color: #DDEAF6;
    out property <brush> when-color: #E1EFD8;
    out property <brush> why-color: #FFF2CC;

    out property <brush> where-border: #1E4E79;
    out property <brush> when-border: #385623;
    out property <brush> why-border: #E9D79D;

    out property <length> border-width: 2px;
    out property <length> border-radius: 5px;
}

export component BasicPhraseStage inherits Rectangle {
    property <int> stage: 0;

    out property <string> subject: selected_line == -1 ? "" : subjects_objects[selected_line].subject;
    out property <string> verb: selected_line == -1 ? "" : head.verb-text;
    out property <string> object: selected_line == -1 ? "" : subjects_objects[selected_line].object;

    out property <bool> can-next: (read_verb_n != 5 || selected_line != -1) && (!self.help || help.can-next);

    out property <[{ subject: string, object: string, selected: bool, reset: bool }]> subjects_objects: [
        { subject: "", object: "", selected: false, reset: false },
        { subject: "", object: "", selected: false, reset: false },
        { subject: "", object: "", selected: false, reset: false },
    ];

    public function reset() {
        stage = 0;
        head.verb-text = "";
        subjects_objects[0].reset = true;
        subjects_objects[1].reset = true;
        subjects_objects[2].reset = true;
    }

    function set_selected(text: string) {
        if line_n == 0 || line_n > 3 {
            return;
        }
        if column_n == 0 {
            subjects_objects[line_n - 1].subject = text;
        }
        if column_n == 1 {
            subjects_objects[line_n - 1].object = text;
        }
    }

    public function next() {
        if self.help {
            self.help = false;
            set_selected(help.word);
            help.reset();
            stage += 1;

            return;
        }
        if selected_line != -1 && stage == 15 {
            done();
            return;
        }
        stage += 1;

        // workaround to avoid loosing focus when hiding last focused element in 1 specific case (might look for real fix eventually)
        if read_verb_n == -1 {
            focus.focus();
        }
    }
    public function back() {
        if self.help {
            self.help = false;
            help.reset();

            return;
        }
        stage -= 1;

        // workaround to avoid loosing focus when hiding last focused element in 1 specific case (might look for real fix eventually)
        if stage == 0 {
            focus.focus();
        }
        if stage == -1 {
            exit();
        }
    }

    private property <int> line_n: stage / 2;
    private property <int> column_n: Math.mod((stage), 2);

    private property <int> read_verb_n: stage - 10;
    private property <bool> select_stage: read_verb_n > 3;

    private property <brush> subject-color:  #DDEAF6;
    private property <brush> verb-color:  #F4AF91;
    private property <brush> object-color:  #E1EFD8;

    private property <brush> subject-border: #BACDDD;
    private property <brush> verb-border: #A56C46;
    private property <brush> object-border: #BBC8B2;

    private property <int> selected_line: -1;

    private property <bool> help;

    focus := FocusScope {
        help-button := TouchArea {
            visible: stage > 1 && stage < 8 && !root.help;

            clicked => {
                root.help = true;
            }

            x: (-root.width / 2) + 35px;
            y: (-root.height / 2) + 35px;

            Rectangle {
                width: 35px;
                height: 35px;

                border-radius: 35px / 2;
                border-width: 2px;

                background: pink;
                border-color: hotpink;

                Image {
                    source: @image-url("assets/question.svg");
                    width: 80%;
                    height: 80%;
                }
            }
        }

        phrases := HorizontalLayout {
            visible: read_verb_n != -1 && read_verb_n != 4 && !root.help;

            main := VerticalLayout {
                padding-left: 85px;
                padding-right: 85px;
                padding-top: 50px;
                padding-bottom: 50px;

                spacing: 25px;
                width: 100%;

                head := SubjectVerbObject {
                    subject-text: "Vem";
                    object-text: "Vad";

                    text-color: black;
                    font-weight: 600;

                    spacing: 50px;

                    vertical-stretch: 1;
                    min-height: 50px;

                    border-radius: 5px;
                    border-width: 2px;

                    subject-background: subject-color;
                    verb-background: verb-color;
                    object-background: object-color;

                    subject-border-color: subject-border;
                    verb-border-color: verb-border;
                    object-border-color: object-border;
                    verb-visible: stage > 0 && read_verb_n <= 0;
                    subject-read-only: true;

                    verb-read-only: stage != 1;
                    verb_focused: !self.verb-read-only;

                    object-read-only: true;

                    horizontal_alignment: center;
                    vertical_alignment: center;
                }

                for line[index] in subjects_objects: Rectangle {
                    min-height: 50px;

                    TouchArea {
                        visible: read_verb_n == 5;

                        width: 25px;
                        height: 25px;
                        x: parent.width + 25px;

                        clicked => {
                            if selected_line == index {
                                selected_line = -1;
                            } else {
                                selected_line = index;
                            }
                        }

                        Rectangle {
                            background: subject-color;
                            border-color: subject-border;
                            border-radius: 2px;
                            border-width: 1px;

                            width: 100%;
                            height: 100%;

                            Image {
                                visible: selected_line == index;

                                source: @image-url("assets/cross.svg");
                                width: 100%;
                                height: 100%;
                                image-fit: fill;
                            }
                        }
                    }

                    SubjectVerbObject {

                        subject-text: line.subject;
                        verb-text: head.verb-text;
                        object-text: line.object;

                        property <bool> reset: line.reset;

                        // subject-in and object-in exist as a substitute for a two way binding between line.subject/line.object and self.subject-text/self.object-text, which currently is not supported.
                        property <string> subject-in: line.subject;
                        property <string> object-in: line.object;

                        changed subject-in => {
                            self.subject-text = subject-in;
                        }

                        changed object-in => {
                            self.object-text = object-in;
                        }

                        changed reset => {
                            if reset {
                                line.subject = "";
                                line.object = "";
                                line.reset = false;
                            }
                        }

                        changed subject-text => {
                            if self.subject-text != line.subject {
                                line.subject = self.subject-text;
                            }
                        }
                        changed object-text => {
                            if self.object-text != line.object {
                                line.object = self.object-text;
                            }
                        }

                        width: 100%;
                        height: 100%;

                        text-color: black;
                        font-weight: 600;

                        vertical-stretch: 1;

                        spacing: 50px;

                        border-radius: 5px;
                        border-width: 2px;

                        verb-background: verb-color;

                        subject-border-color: subject-border;
                        object-border-color: object-border;

                        subject-visible: line_n > index;
                        verb-visible: read_verb_n == index + 1 || select_stage;
                        object-visible: line_n > index;

                        subject-read-only: line_n > index + 1 || column_n == 1;
                        verb-read-only: true;
                        object-read-only: line_n > index + 1 || column_n == 0;

                        subject_focused: self.subject_visible && !self.subject-read-only;
                        object_focused: self.object_visible && !self.object-read-only;

                        horizontal_alignment: center;
                        vertical_alignment: center;
                    }
                }
            }
        }

        Text {
            visible: read_verb_n == -1;
            text: "Steg 2: Läs meningarna högt";
            font-weight: FontWeight.bold;
        }

        Text {
            visible: read_verb_n == 4;
            text: "Steg 3: Utveckla en mening";
            font-weight: FontWeight.bold;
        }

        help := HorizontalLayout {
            visible: root.help;
            property <bool> can-next: selected_word != -1;
            property <int> selected_word: -1;

            out property <string> word: selected_word == -1 ? "" : words[selected_word].word;
            out property <[{ word: string, reset: bool }]> words: [
                { word: "", reset: false },
                { word: "", reset: false },
                { word: "", reset: false },
                { word: "", reset: false }
            ];

            function reset() {
                self.words[0].reset = true;
                self.words[1].reset = true;
                self.words[2].reset = true;
                self.words[3].reset = true;

                self.selected_word = -1;

                focus.focus();
            }

            VerticalLayout {
                padding-left: 85px;
                padding-right: 85px;
                padding-top: 50px;
                padding-bottom: 50px;

                spacing: 25px;
                width: 100%;

                for line[index] in words: rct := Rectangle {
                    min-height: 50px;

                    LineInput {
                        background: subject-color;
                        border-color: subject-border;
                        text-color: black;

                        horizontal_alignment: center;

                        border-radius: 5px;
                        border-width: 2px;

                        font-weight: 600;

                        changed text => {
                            line.word = self.text;
                        }

                        property <bool> reset: line.reset;

                        changed reset => {
                            if self.reset {
                                self.text = "";
                                line.reset = false;
                            }
                        }
                    }

                    TouchArea {
                        width: 25px;
                        height: 25px;
                        x: parent.width + 25px;

                        clicked => {
                            if selected_word == index {
                                selected_word = -1;
                            } else {
                                selected_word = index;
                            }
                        }

                        Rectangle {
                            background: subject-color;
                            border-color: subject-border;
                            border-radius: 2px;
                            border-width: 1px;

                            width: 100%;
                            height: 100%;

                            Image {
                                visible: selected_word == index;

                                source: @image-url("assets/cross.svg");
                                width: 100%;
                                height: 100%;
                                image-fit: fill;
                            }
                        }
                    }
                }
            }
        }
    }

    callback done();
    callback exit();
}

export component ExpandPhraseStage inherits Rectangle {
    property <int> stage: -1;

    out property <bool> can-next: true;

    in property <string> subject;
    in property <string> verb;
    in property <string> object;

    public function next() {
        self.stage += 1;

        if self.stage >= 8 {
            done();
        }
    }

    public function back() {
        self.stage -= 1;

        if self.stage == -1 {
            exit()
        }
    }

    public function reset() {
    }

    expand := VerticalLayout {
        visible: stage < 3;

        padding-left: 85px;
        padding-right: 85px;
        padding-top: 50px;
        padding-bottom: 50px;

        spacing: 25px;

        height: 100%;
        width: 100%;

        what := SubjectVerbObject {
            min-height: 50px;

            spacing: 50px;

            subject-text: subject;
            verb-text: verb;
            object-text: object;

            horizontal_alignment: center;
            vertical_alignment: center;

            text-color: black;
            font-weight: 600;

            border-radius: Style.border-radius;
            border-width: Style.border-width;

            verb-background: Style.verb-color;

            subject-border-color: Style.subject-border;
            verb-border-color: Style.verb-border;
            object-border-color: Style.object-border;
        }

        for line[i] in [
            { text: "", label: "Var", color: Style.where-color, border: Style.where-border },
            { text: "", label: "När", color: Style.when-color, border: Style.when-border },
            { text: "", label: "Varför", color: Style.why-color, border: Style.why-border }
        ]: HorizontalLayout {
            visible: root.stage >= i;

            vertical-stretch: 1;

            min-height: 50px;
            spacing: 50px;

            TextBox {
                width: 30%;

                background: line.color;
                border-color: line.border;

                border-width: Style.border-width;
                border-radius: Style.border-radius;

                text-color: black;
                font-weight: 600;

                text: line.label;
            }

            LineInput {
                read_only: root.stage > i;

                background: transparent;
                border-color: red;

                border-width: Style.border-width;
                border-radius: Style.border-radius;

                text-color: black;
                font-weight: 600;

                horizontal_alignment: center;

                text: line.text;

                private property <bool> focused: (root.stage == i);

                changed focused => {
                    if focused {
                        self.focus()
                    } else if self.has-focus {
                        self.clear-focus()
                    }
                }

                changed text => {
                    line.text = self.text;
                }
            }
        }
    }

    Text {
        visible: stage == 3;
        text: "Steg 4: Lyssna på meningar";
        font-weight: FontWeight.bold;
    }

    Text {
        visible: stage == 4;
        text: "Steg 5: Vilket var verbet";
        font-weight: FontWeight.bold;
    }

    LineInput {
        visible: stage == 5;

        text: "?";

        read_only: true;

        horizontal_alignment: center;
        vertical_alignment: center;

        text-color: black;
        font-weight: 600;

        width: what.box-width;
        height: what.box-height;

        border-radius: Style.border-radius;
        border-width: Style.border-width;

        background: Style.verb-color;
        border-color: Style.verb-border;
    }

    LineInput {
        visible: stage == 6;
        text: verb;
        read_only: true;

        horizontal_alignment: center;
        vertical_alignment: center;

        text-color: black;
        font-weight: 600;

        width: what.box-width;
        height: what.box-height;

        border-radius: Style.border-radius;
        border-width: Style.border-width;

        background: Style.verb-color;
        border-color: Style.verb-border;
    }

    Text {
        visible: stage == 7;
        text: "Steg 6: Konstruera meningar igen";
        font-weight: FontWeight.bold;
    }

    callback done();
    callback exit();
}
