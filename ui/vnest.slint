import { StyleMetrics, HorizontalBox } from "std-widgets.slint";
import { TextBox, LineInput } from "text_box.slint";

export component VNeSTMain inherits Rectangle {
    in-out property <int> stage;

    property <string> verb: "";

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 50px;

            TextBox {
                width: 250px;
                height: 100px;

                border-radius: 5px;
                border-width: 2px;

                text: "Vem";
                font-size: 24px;
                font-weight: 600;
                text-color: black;
                background: lightblue;
            }

            verb_input := LineInput {
                width: 250px;
                height: 100px;

                border-radius: 5px;
                border-width: 2px;

                text: "";
                font-size: 24px;
                font-weight: 600;
                text-color: black;
                background: lightblue;

                horizontal_alignment: center;
            }

            TextBox {
                preferred-width: 250px;
                preferred-height: 100px;

                border-radius: 5px;
                border-width: 2px;

                text: "Vad";
                font-size: 24px;
                font-weight: 600;
                text-color: black;
                background: lightgreen;
            }
        }

        HorizontalBox {
            alignment: center;
            spacing: 50px;
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
