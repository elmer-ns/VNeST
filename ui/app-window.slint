import { Button, VerticalBox } from "std-widgets.slint";

component WhoWhat {
    out property <string> who;
    out property <string> what;

    in property <length> spacing;

    in property <string> verb;

    forward-focus: Who;

    callback next();

    HorizontalLayout {
        spacing: spacing;
        Rectangle {border-width: 2px ;border-color: blue; 
            Who := TextInput {
                color: black; text: who; vertical-alignment: center; horizontal-alignment: center;
                edited => {who=self.text}
                accepted => {What.focus()}
            }
        }
        Rectangle {border-width: 2px; border-color: blue;
            Text {color: black; text: verb;}
            min-width: parent.width/3.0;
        }
        Rectangle {border-width: 2px; border-color: blue;
            What := TextInput {
                color: black; text: what; vertical-alignment: center; horizontal-alignment: center;
                edited => {what=self.text}
                accepted => {next()}
            }
        }
    }
}

component Verb {
    out property <string> verb;
    in property <length> spacing;

    callback next();

    forward-focus: verb_input;

    HorizontalLayout {
        spacing: spacing;
        Rectangle {border-width: 2px ;border-color: blue; 
            Text {color: black; text: "Vem"; vertical-alignment: center; horizontal-alignment: center;}
        }
        Rectangle {border-width: 2px; border-color: blue;
            verb_input := TextInput {
                color: black; text: verb; vertical-alignment: center; horizontal-alignment: center;
                edited => {verb=self.text}
                accepted => {next()}
            }
            max-width: parent.width/3.0;
        }
        Rectangle {border-width: 2px; border-color: blue;
            Text {color: black; text: "Vad"; vertical-alignment: center; horizontal-alignment: center;}
        }
    }
}

export component AppWindow inherits Window {
    property <length> padx: self.width*0.05;
    property <length> pady: self.height*0.05;

    in property <image> ico;

    forward-focus: v1;
    background: white;

    title: "VNeST-S";
    icon: ico;

    VerticalLayout {
        spacing: padx;
        padding: self.height*0.15;

        v1 := Verb {
            spacing: padx;
            next => {
                wh1.focus()
            }
        }
        wh1 := WhoWhat {
            spacing: padx;
            verb: v1.verb;
            next => {
                wh2.focus()
            }
        }
        wh2 := WhoWhat {
            spacing: padx;
            verb: v1.verb;
            next => {
                wh3.focus()
            }
        }
        wh3 := WhoWhat {
            spacing: padx;
            verb: v1.verb;
        }
    }
}