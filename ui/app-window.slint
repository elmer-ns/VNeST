import "../NotoSans.ttf";

import "fonts/SpaceMono/SpaceMono-Regular.ttf";
import "fonts/SpaceMono/SpaceMono-Bold.ttf";
import "fonts/SpaceMono/SpaceMono-BoldItalic.ttf";
import "fonts/SpaceMono/SpaceMono-Italic.ttf";
import { Button } from "std-widgets.slint";
import { BasicPhraseStage } from "vnest.slint";

export enum State {menu, about, vnest}

component MainMenu inherits Rectangle {
    width: 100%;
    height: 100%;

    in-out property <State> state;

    VerticalLayout {
        alignment: center;
        spacing: 15px;

        Text {
            text: "Verb - Nätverksstärkande Träning (VNeST-S)";
            font-size: 32px;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Text {
            text: "Verb Network Strengthening Treatment - svensk version";
            font-size: 24px;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            padding-top: 25px;
            width: 50%;
            spacing: 50px;

            Button {
                text: "Starta";
                primary: true;

                clicked => {
                    state = State.vnest;
                }
            }

            Button {
                text: "Om";

                clicked => {
                    state = State.about;
                }
            }
        }
    }
}

component AboutPage inherits Rectangle {
    width: 100%;
    height: 100%;

    in-out property <State> state;

    Button {
        text: "Tillbaka";
        clicked => {
            state = State.menu;
        }

        x: 20px;
        y: parent.height - self.height - 20px;
    }
}

enum VNeSTState {basic_phrase}

component VNeST inherits Rectangle {
    in-out property <State> app_state;
    property <VNeSTState> state: VNeSTState.basic_phrase;

    public function next() {
        if state == VNeSTState.basic-phrase {
            basic_phrase.next()
        }
    }
    public function back() {
        if state == VNeSTState.basic-phrase {
            basic_phrase.back()
        }
    }

    VerticalLayout {
        basic_phrase := BasicPhraseStage {
            visible: false;

            exit => {
                app_state = State.menu;
                basic_phrase.reset();
            }
        }

        states [
            basic_phrase when state == VNeSTState.basic-phrase: {
                basic_phrase.visible: true;
            }
        ]

        HorizontalLayout {
            alignment: space-between;
            padding: 15px;
            Button {
                text: "Tillbaka";
                clicked => {
                    back()
                }
                y: parent.height - self.height - 20px;
            }

            Button {
                text: "Nästa";
                clicked => {
                    next()
                }

                y: parent.height - self.height - 20px;
            }
        }
    }
}

export component AppWindow inherits Window {
    property <State> state;

    title: "VNeST-S";

    changed state => {
        self.focus()
    }

    state: State.menu;

    default-font-family: "Space Mono";
    default-font-size: 24px;

    function next() {
        if state == State.vnest {
            vnest.next()
        }
        if state == State.menu {
            state = State.vnest
        }
        if state == State.about {
            state = State.menu
        }
    }

    function back() {
        if state == State.about {
            state = State.menu
        }
        if state == State.vnest {
            vnest.back()
        }
    }

    states [
        menu when state == State.menu: {
            menu.visible: true;
            about.visible: false;
            vnest.visible: false;
        }
        about when state == State.about: {
            menu.visible: false;
            about.visible: true;
            vnest.visible: false;
        }
        vnest when state == State.vnest: {
            menu.visible: false;
            about.visible: false;
            vnest.visible: true;
        }
    ]

    forward-focus: scope;

    scope := FocusScope {
        capture_key_pressed(event) => {
            // RETURN -> next()
            if event.text == "\n" {
                next();
                return accept;
            }

            // FRONT_ARROW -> next()
            if event.text == "" {
                next();
                return accept;
            }

            // BACK_ARROW -> back()
            if event.text == "" {
                back();
                return accept;
            }

            //ESCAPE -> back()
            if event.text == "" {
                back();
                return accept;
            }
            return reject;
        }

        menu := MainMenu {
            state <=> state;
        }

        about := AboutPage {
            state <=> state;
        }

        vnest := VNeST {
            app_state <=> state;
        }
    }
}
