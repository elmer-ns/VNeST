import { Button, VerticalBox } from "std-widgets.slint";

import "../NotoSans.ttf";
import "../SpaceMono-Regular.ttf";


export global ValidateString {
    callback limit_size(string,length,length) -> string;
}

component WhoWhat {
    out property <string> who;
    out property <string> what;

    in property <length> font-size;

    in property <length> spacing;

    in property <string> verb;

    forward-focus: Who;

    callback next();

    HorizontalLayout {
        spacing: spacing;
        Rectangle {border-width: 2px ;border-color: blue; 
            Who := TextInput {
                color: black; text: who; vertical-alignment: center; horizontal-alignment: center; font-size: root.font-size;
                edited => {self.text=ValidateString.limit_size(self.text,self.width,self.font-size);who=self.text}
                accepted => {What.focus()}
            }
        }
        Rectangle {border-width: 2px; border-color: blue;
            Text {color: black; text: verb; font-size: root.font-size;}
            width: root.width/3.0-root.spacing/2.0;
        }
        Rectangle {border-width: 2px; border-color: blue;
            What := TextInput {
                color: black; text: what; vertical-alignment: center; horizontal-alignment: center; font-size: root.font-size;
                edited => {self.text=ValidateString.limit_size(self.text,self.width,self.font-size);what=self.text}
                accepted => {next()}
            }
        }
    }
}
export component Verb inherits Rectangle {
    out property <string> verb;
    in property <length> spacing;

    in property <length> font-size;

    callback next();

    forward-focus: verb_input;

    HorizontalLayout {
        spacing: spacing;
        Rectangle {border-width: 2px ;border-color: blue; 
            Text {color: black; text: "Vem"; vertical-alignment: center; horizontal-alignment: center; font-size: root.font-size;}
        }
        Rectangle {border-width: 2px; border-color: blue;
            verb_input := TextInput {
                color: black; text: verb; vertical-alignment: center; horizontal-alignment: center; font-size: root.font-size;
                edited => {self.text=ValidateString.limit_size(self.text,self.width,self.font-size);verb=self.text}
                accepted => {next();}
            }
            width: root.width/3.0-root.spacing/2.0;
        }
        Rectangle {border-width: 2px; border-color: blue;
            Text {color: black; text: "Vad"; vertical-alignment: center; horizontal-alignment: center; font-size: root.font-size;}
        }
    }
}

component View1 inherits Rectangle {
    in property <percent> padding_percent;
    in property <percent> spacing_percent;
    
    in property <length> font-size;

    forward-focus: verb;

    callback next();

    VerticalLayout {
        spacing: parent.height*spacing_percent;
        padding: parent.height*padding_percent;

        verb := Verb {
            font-size: root.font-size;
            spacing: parent.width*spacing_percent;
            next => {
                wh1.focus()
            }
        }
        wh1 := WhoWhat {
            font-size: root.font-size;
            spacing: parent.width*spacing_percent;
            verb: verb.verb;
            next => {
                wh2.focus()
            }
        }
        wh2 := WhoWhat {
            font-size: root.font-size;
            spacing: parent.width*spacing_percent;
            verb: verb.verb;
            next => {
                wh3.focus()
            }
        }
        wh3 := WhoWhat {
            font-size: root.font-size;
            spacing: parent.width*spacing_percent;
            verb: verb.verb;
            next => {
                next();
            }
        }
    }
}

enum State {view1, help}

export component AppWindow inherits Window {
    in property <image> _icon;

    title: "VNeST-S";
    icon: _icon;

    default-font-family: "Space Mono";

    min-width: 600px;
    min-height: 500px;

    forward-focus: View1;
    background: white;

    property <State> state: State.view1;

    states [
        view1 when state == State.view1: {
            View1.visible: true;
            HelpButton.visible: true;
        }
        help when state == State.help: {
            View1.visible: false;
            HelpButton.visible: false;
        }
    ]

    View1 := View1 {
        font-size: parent.width*0.015;
        padding_percent: 10%;
        spacing_percent: 10%;
    }
    HelpButton := Rectangle {
        background: green;
        width: (root.width+root.height)*0.02;
        height: (root.width+root.height)*0.02;
        x: self.width * 0.5;
        y: root.height - self.height*1.5;

        TouchArea {
            clicked => {
                state = State.help;
            }
        }
    }
}